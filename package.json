{
    "name": "kao",
    "version": "1.0.0",
    "private": true,
    "description": "Manga avatar editor with lossless high-resolution export.",
    "license": "BSD-3-Clause",
    "type": "module",
    "scripts": {
        "dev": "next dev -H 127.0.0.1 -p 7711",
        "build": "next build",
        "start": "npx serve out -p 7712",
        "lint": "eslint",
        "check": "tsc --noEmit && eslint . && prettier --check .",
        "format": "prettier --write . && eslint --fix .",
        "test": "playwright test",
        "shots": "KAO_SHOTS=1 playwright test tests/shots.spec.ts",
        "build:swf": "./scripts/swf.sh",
        "check:assets": "python3 scripts/assets.py"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.56.0",
        "next": "16.4.0",
        "next-intl": "^4.14.9",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.8.1",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.0",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-check-file": "^3.3.2",
        "eslint-plugin-import": "^2.32.0",
        "prettier": "^3.9.10",
        "serve": "^14.2.6",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5"
    },
    "overrides": {
        "compression": "1.8.2"
    }
}
